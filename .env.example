# Copy to .env and fill in. Read by docker compose (backend, bot, db) and by `manage.py` run on the host.
# Values below are examples only.

# Signs sessions and customer tokens, and encrypts the stored bot tokens: changing it disconnects every bot.
SECRET_KEY=change-me
DEBUG=False

# --- Database: each business lives in its own PostgreSQL schema ---
POSTGRES_DB=deliveryhub
POSTGRES_USER=deliveryhub
POSTGRES_PASSWORD=change-me
# Only for running the backend or the bot on the host (compose sets these for the containers):
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
# REDIS_URL=redis://localhost:6379/0

# --- Ports on the host (docker compose) ---
# The web container (all hosts, plain HTTP; TLS ends at the edge proxy in front — docs/deploy.md)
WEB_PORT=8100
# 127.0.0.1: only the edge proxy / tunnel on this host reaches it; 0.0.0.0 opens it to the network
WEB_BIND=127.0.0.1
DB_PORT=5440
# Backend workers (gunicorn reads this itself), e.g. smaller on a small server:
# GUNICORN_CMD_ARGS=--workers 2 --threads 4

# --- Platform ---
# Every business gets <slug>.<PLATFORM_DOMAIN> (shop + Mini App) and <slug>-admin.<PLATFORM_DOMAIN> (admin panel);
# our panel is <PLATFORM_HUB_SUBDOMAIN>.<PLATFORM_DOMAIN>. Locally the same names work under .localhost.
PLATFORM_DOMAIN=sizlarbilan.uz
PLATFORM_HUB_SUBDOMAIN=deliveryhub
# The domain is shared with other projects: their subdomains, which no business may take (comma separated)
PLATFORM_RESERVED_SUBDOMAINS=
# Our platform bot: creates the bots of businesses (Telegram Managed Bots). In @BotFather enable
# "Bot Management" for it. Without it bots are connected with tokens from @BotFather on the business page.
PLATFORM_BOT_TOKEN=
# Our panel's account; created / updated on every backend start (`manage.py ensure_platform`).
PLATFORM_ADMIN_PHONE=+998901234567
PLATFORM_ADMIN_PASSWORD=change-me-too
# Optional: a file listing the subdomains to expose, for a tunnel supervisor on the host (portex).
# TUNNELS_FILE=/path/to/tunnels.txt

# Extra trusted origins for CSRF (every https subdomain of PLATFORM_DOMAIN is trusted automatically).
CSRF_TRUSTED_ORIGINS=
# None (HTTPS only): the admin Mini App keeps its session inside Telegram Web's iframe.
COOKIE_SAMESITE=Lax
# True in production (served over HTTPS only): cookies are never sent over plain HTTP
COOKIE_SECURE=False

# --- Phone sign-in codes in the shops: console (codes go to the backend log) | eskiz | telegram_gateway ---
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_MESSAGE={shop}: tasdiqlash kodi {code}
TELEGRAM_GATEWAY_TOKEN=
# Local development only — returns the sign-in code to the UI. Never enable in production.
SHOP_OTP_DEBUG=False

# --- Voice / AI order entry (admin panel "Sales", staff bot) — Google Gemini API ---
# Key: https://aistudio.google.com/apikey  (without a key typed orders still work)
GEMINI_API_KEY=
GEMINI_PARSE_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy (503) or rate-limited
GEMINI_PARSE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_ENABLED=True

# --- Maps: addresses ⇄ points (shop checkout, our panel) — a Nominatim server, OpenStreetMap data ---
# The public server needs no key (one request a second; answers are cached). Empty URL = switched off.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRIES=uz
# GEOCODER_USER_AGENT=DeliveryHub/1.0 (+https://deliveryhub.example.uz)

# A fake or local Telegram Bot API server (tests, development)
# TELEGRAM_API_URL=https://api.telegram.org
