# The web container: one entry point for every host of the platform (docs/architecture.md).
#   /api/*, /healthz          → backend (it picks the business and the API by the host)
#   /media/*                  → uploaded files (product images, logos)
#   /django-admin/*, /static/* → backend (Django admin for our staff, on the platform host)
#   the bare domain           → our page for businesses (landing/; localhost on a developer's machine); its
#                               two API calls (the form, the sample shop) reach the backend as our panel's host
#   everything else           → the UI of the host: our panel, a business's admin panel or its shop
# TLS ends in front of this container (the tunnel or a load balancer), so it serves plain HTTP.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# The two calls of our page for businesses (its form, its sample shop): the backend answers the platform API
	# only on our panel's host, and nothing else of that API is open on the bare domain.
	@landingApi {
		host {$PLATFORM_DOMAIN}
		path /api/v1/leads /api/v1/landing/config
	}
	handle @landingApi {
		request_body {
			max_size 16KB
		}
		reverse_proxy backend:8000 {
			header_up Host {$PLATFORM_HUB_SUBDOMAIN:deliveryhub}.{$PLATFORM_DOMAIN}
		}
	}

	@backend path /api/* /healthz /django-admin /django-admin/* /static/*
	handle @backend {
		request_body {
			max_size 25MB
		}
		reverse_proxy backend:8000
	}

	# An uploaded file never changes at its address (a new upload gets a new name), so it is cached for good.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Our page for businesses: the bare domain (www. is sent there by the edge) and localhost.
	@landing host {$PLATFORM_DOMAIN} localhost
	handle @landing {
		reverse_proxy landing:80
	}

	@platform expression `{host}.startsWith("{$PLATFORM_HUB_SUBDOMAIN:deliveryhub}.") || {host}.startsWith("hub.")`
	handle @platform {
		reverse_proxy deliveryhub-ui:80
	}

	@admin expression `{host}.matches("^[a-z0-9-]+-admin[.]")`
	handle @admin {
		reverse_proxy admin-ui:80
	}

	handle {
		reverse_proxy client-ui:80
	}
}
