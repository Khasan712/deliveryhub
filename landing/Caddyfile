{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# The page: Uzbek at / and /uz, Russian at /ru.
	@ru path /ru /ru/
	rewrite @ru /ru/index.html
	@uz path / /uz /uz/
	rewrite @uz /index.html

	# Fonts, photos and the icon have content-hashed names: cached for a year.
	handle /landing/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The pages themselves are revalidated on every visit (ETag → 304), so a deploy shows at once.
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
